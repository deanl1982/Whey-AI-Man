# Terraform Variables for Disk Cleanup Lab
# Copy this file to terraform.tfvars and customize

# Resource group name (change to avoid conflicts)
resource_group_name = "rg-disk-cleanup-lab"

# Azure region (preferred - used as tiebreaker when costs are equal)
location = "uksouth"

# Candidate regions to check for SKU availability and cost
# The best region is selected automatically based on availability and price
# candidate_regions = ["uksouth", "ukwest", "northeurope", "westeurope"]

# VM admin credentials
admin_username = "adminuser"
admin_password = "YourSecurePassword123!"  # CHANGE THIS!

# Number of VMs to create (one per lab participant)
# For demo/testing: set to 1
# For group lab: set to number of participants
vm_count = 1

# VM size/SKU (must be available in at least one candidate region)
# Default: Standard_D4s_v3 (4 vCPU, 16GB RAM) - optimal for Ollama/llama3.2
# Terraform will automatically check availability across candidate regions
# and select the best region based on availability and cost.
# If no candidate region has this SKU, you'll get an error with instructions.
# Alternative sizes: "Standard_D4s_v4", "Standard_D4s_v5", "Standard_D4as_v5"
vm_size = "Standard_D4s_v3"
