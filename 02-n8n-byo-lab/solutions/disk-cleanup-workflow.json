{
  "name": "Disk Space Cleanup with AI",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 60
            }
          ]
        }
      },
      "name": "Schedule Trigger (Every 60s)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "command": "df -h /tmp | tail -1 | awk '{print $5}'"
      },
      "name": "Check Disk Usage",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Parse disk usage percentage from df output\nconst stdout = $input.first().json.stdout;\nconst percentStr = stdout.trim().replace('%', '');\nconst percent = parseInt(percentStr);\n\nreturn [{\n  json: {\n    disk_usage_percent: percent,\n    disk_usage_raw: stdout.trim(),\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "name": "Parse Percentage",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.disk_usage_percent }}",
              "operation": "larger",
              "value2": 85
            }
          ]
        }
      },
      "name": "IF Usage > 85%",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [850, 300]
    },
    {
      "parameters": {
        "command": "du -sh /tmp/* 2>/dev/null | sort -rh | head -10"
      },
      "name": "Analyze Space Usage",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1050, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:11434/api/generate",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "llama2"
            },
            {
              "name": "prompt",
              "value": "You are a Linux sysadmin. The /tmp directory is at {{ $('Parse Percentage').item.json.disk_usage_percent }}% usage. Here are the largest items:\n\n{{ $json.stdout }}\n\nBased on this, what directory should we clean up? Respond with ONLY the path to clean, nothing else. Example: /tmp/logs"
            },
            {
              "name": "stream",
              "value": "false"
            }
          ]
        },
        "options": {}
      },
      "name": "Call Ollama for Analysis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [1250, 200]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Parse Ollama response and extract cleanup path\nconst ollamaResponse = $input.first().json.response;\nconst cleanupPath = ollamaResponse.trim();\n\n// Get disk usage from earlier node\nconst diskUsageBefore = $('Parse Percentage').item.json.disk_usage_percent;\n\nreturn [{\n  json: {\n    cleanup_path: cleanupPath,\n    disk_usage_before: diskUsageBefore,\n    llm_response: ollamaResponse\n  }\n}];"
      },
      "name": "Parse LLM Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1450, 200]
    },
    {
      "parameters": {
        "command": "find {{ $json.cleanup_path }} -type f -mtime +7 -delete"
      },
      "name": "Execute Cleanup",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1650, 200]
    },
    {
      "parameters": {
        "command": "df -h /tmp | tail -1 | awk '{print $5}'"
      },
      "name": "Verify Cleanup",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1850, 200]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Format cleanup results notification\nconst stdoutAfter = $input.first().json.stdout;\nconst usageAfter = parseInt(stdoutAfter.replace('%', '').trim());\nconst usageBefore = $('Parse LLM Response').item.json.disk_usage_before;\nconst cleaned = usageBefore - usageAfter;\nconst cleanupPath = $('Parse LLM Response').item.json.cleanup_path;\n\nconst message = `✅ Disk Space Cleanup Complete\n\nBefore: ${usageBefore}%\nAfter: ${usageAfter}%\nSpace Freed: ~${cleaned}%\nCleaned: ${cleanupPath}\nTimestamp: ${new Date().toISOString()}`;\n\nconsole.log(message);\n\nreturn [{ \n  json: {\n    message,\n    usage_before: usageBefore,\n    usage_after: usageAfter,\n    space_freed: cleaned,\n    cleanup_path: cleanupPath\n  }\n}];"
      },
      "name": "Format Notification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2050, 200]
    },
    {
      "parameters": {},
      "name": "Disk Space OK (No Action)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1050, 400]
    }
  ],
  "connections": {
    "Schedule Trigger (Every 60s)": {
      "main": [
        [
          {
            "node": "Check Disk Usage",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Disk Usage": {
      "main": [
        [
          {
            "node": "Parse Percentage",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Percentage": {
      "main": [
        [
          {
            "node": "IF Usage > 85%",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF Usage > 85%": {
      "main": [
        [
          {
            "node": "Analyze Space Usage",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Disk Space OK (No Action)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Analyze Space Usage": {
      "main": [
        [
          {
            "node": "Call Ollama for Analysis",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Ollama for Analysis": {
      "main": [
        [
          {
            "node": "Parse LLM Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse LLM Response": {
      "main": [
        [
          {
            "node": "Execute Cleanup",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execute Cleanup": {
      "main": [
        [
          {
            "node": "Verify Cleanup",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify Cleanup": {
      "main": [
        [
          {
            "node": "Format Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {},
  "staticData": null,
  "tags": [],
  "triggerCount": 0,
  "updatedAt": "2026-02-15T00:00:00.000Z",
